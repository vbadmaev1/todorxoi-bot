# Скопируйте этот файл в .env и заполните.
# .env в git не попадает (см. .gitignore) — токен там и должен оставаться.

# Токен от @BotFather — единственная обязательная переменная
BOT_TOKEN=123456789:AAAA-BBBB_CCCCCCCCCCCCCCCCCCCCCCCCC

# Telegram-id тех, кому доступны /stats и /export.
# Свой id можно узнать у @userinfobot. Несколько — через запятую.
# Пока пусто — админских команд нет ни у кого.
ADMIN_IDS=

# Куда складывать базу и лог фидбэка.
# ВАЖНО: на хостинге с эфемерным диском это должен быть volume,
# иначе весь собранный фидбэк исчезнет при рестарте.
DATA_DIR=./data

# Пути к артефактам (по умолчанию — те, что лежат в репозитории)
# MODEL_PATH=./model/translit_model.npz
# FONT_PATH=./assets/MongolianUniversalWhite.ttf

# Прогревать модель на старте (первый пользователь не ждёт загрузку)
WARMUP=true

# Показывать 👍/👎 ещё и под обычной транслитерацией, а не только
# под тодо бичиг и картинкой
FEEDBACK_ON_TRANSLIT=true

# Параметры рендера картинки
FONT_SIZE=64
MAX_COLUMN_HEIGHT=900

# Если в окружении нет ни uharfbuzz, ни Pillow с Raqm, буквы не соединяются.
# По умолчанию бот всё равно рисует картинку, но помечает её
# предупреждением. STRICT_SHAPING=1 — вместо этого отказывать в рендере.
STRICT_SHAPING=0

LOG_LEVEL=INFO
