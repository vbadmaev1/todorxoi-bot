# Вариант без Docker: systemd-юнит для обычного VPS.
#
#   sudo cp deploy/todorxoi.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now todorxoi
#   journalctl -u todorxoi -f        # логи
#
# Поправьте User и пути под свою машину.

[Unit]
Description=Todo Bichig Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=todorxoi
WorkingDirectory=/opt/todorxoi
EnvironmentFile=/opt/todorxoi/.env
ExecStart=/opt/todorxoi/.venv/bin/python -m bot.main
Restart=always
RestartSec=5
# бот сетевой и однопоточный, лишние ресурсы ему не нужны
MemoryMax=1500M

[Install]
WantedBy=multi-user.target
